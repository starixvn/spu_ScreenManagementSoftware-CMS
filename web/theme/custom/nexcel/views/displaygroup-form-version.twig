{% extends "form-base.twig" %}
{% import "forms.twig" as forms %}
{% import "inline.twig" as inline %}

{% block formTitle %}
    {% trans "Set Instructions for Upgrading this Player" %}
{% endblock %}

{% block formButtons %}
    {% trans "Help" %}, XiboHelpRender("{{ help }}")
    {% trans "Cancel" %}, XiboDialogClose()
    {% trans "Save" %}, $("#displayGroupVersionForm").submit()
{% endblock %}

{% block callBack %}displayVersionsFormOpen{% endblock %}
    
{% block formHtml %}
    <div class="row">
        <div class="col-md-12">
            <form id="displayGroupVersionForm" class="XiboForm form-horizontal" method="post" action="{{ urlFor("displayGroup.version", {id: displayGroup.displayGroupId}) }}">
                {% set title %}{% trans "Installer File" %}{% endset %}
                {% set helpText %}{% trans "Select the Installer File that should be pushed to the Players listed and installed." %}{% endset %}
                {{ forms.dropdown("versionFileName", "single", title, "", versions, "fileName", "version", helpText) }}
            </form>
            {{ inline.hidden("displayGroupId", displayGroup.displayGroupId) }}
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h3>{% trans "Current Player Version" %}</h3>
            <table id="displayVersionsTable" class="table table-striped">
                <thead>
                    <tr>
                        <th>{% trans "Display" %}</th>
                        <th>{% trans "Type" %}</th>
                        <th>{% trans "Version" %}</th>
                        <th>{% trans "Version Code" %}</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}