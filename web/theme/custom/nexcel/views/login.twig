<!DOCTYPE html>
<html lang="en">
<head>
    <title>{{ theme.getThemeConfig("theme_title") }}</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="token" content="{{ csrfToken }}"/>
    <link rel="shortcut icon" href="{{ theme.uri("img/favicon.ico") }}" />

    <link href="{{ theme.uri("libraries/bootstrap/css/bootstrap.min.css") }}" rel="stylesheet" media="screen">
    <link href="{{ theme.uri("libraries/bootstrap/css/bootstrap-theme.min.css") }}" rel="stylesheet" media="screen">
    <link href="{{ theme.uri("css/login.css") }}" rel="stylesheet" >

</head>
<body>
    <div class="container">
        <form id="login-form" class="form-signin" action="{{ urlFor("login") }}" method="post" autocomplete="off">
            <input name="priorRoute" type="hidden" value="{{ flash.priorRoute }}" />
            <input type="hidden" name="{{ csrfKey }}" value="{{ csrfToken }}" />
            <p class="logo-section"><a href="{{ theme.getThemeConfig("theme_url") }}"><img src="{{ theme.uri("img/SMS.svg") }}"></a></p>
            <div class="input-field">
               <input id="username" class="input-block-level" name="username" type="text"  >
               <label for="username">Username</label>
            </div>
             <div class="input-field">
               <input id="password" class="input-block-level" name="password" type="password" autocomplete="new-password">
               <label for="password">Password</label>
            </div>

            {% if flash.login_message %}
            <div class="alert alert-danger">{{ flash.login_message }}</div>
            {% endif %}
            <div class=field>
                <input type="checkbox" id="chbSignin" />
                <label for="chbSignin">Keep me signed in </label>
            </div>

            <button class="btn btn-login" type="submit">{% trans "Login" %}</button>
            <div class="text-center"><a class="forgot-password" href="javascript:;">Forgot Password?</a></div>
        </form>

        <!-- p class="text-center">{% trans %}Version {{ version }}{% endtrans %}
            | <a id="source-link" href="{{ theme.getThemeConfig("cms_source_url") }}">{% trans "Source" %}</a>
            | <a id="about-link" class="XiboFormButton" href="{{ urlFor("about") }}" title="{% trans "About" %}">{% trans "About" %}</a>
        </p -->
    </div> <!-- /container -->
    <script src="{{ theme.uri("libraries/jquery/jquery-1.11.1.min.js") }}"></script>
    <script src="{{ theme.uri("libraries/bootstrap/js/bootstrap.min.js") }}"></script>
    <script type="text/javascript">
        $(document).ready(function(){
            
            function checkInput(ele) {
                if(ele.val().length > 0) {
                    ele.addClass('active');
                }
                else {
                    ele.removeClass('active');
                }
            }

            $('.input-field input').focus(function() {
                $this = $(this);
                checkInput($this);
            });

            $('.input-field input').blur(function() {
                $this = $(this);
                checkInput($this);
            });
        });
    </script>
</body>
</html>