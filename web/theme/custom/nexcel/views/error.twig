{% extends "base.twig" %}

{% block content %}
    <div class="error-box">
        <div class="error-text">
            <p class="head">{% trans "Error" %}</p>
            <p class="content">{{ flash.globalError }} <br/> {{ flash.message }}</p>
        </div>
        <div class="error-img"></div>
    </div>
{% endblock %}